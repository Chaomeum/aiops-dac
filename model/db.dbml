  id uuid [pk, not null, note: 'Identificador estable asignado por el servicio propietario. Assumption: A-001. Fuente: architecture.yml#diagnostic_output_component, SRC_ADR_013, DD-006']
  diagnosis_id uuid [not null, note: 'Versión diagnóstica sustentada. Fuente: architecture.yml#diagnostic_output_component, SRC_ADR_013, DD-006']
  evidence_id uuid [not null, note: 'Evidencia operacional consultada por ID lógico. Referencia lógica a evidence.evidence_items.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#diagnostic_output_component, SRC_ADR_013, DD-006']
  correlation_id text [not null, note: 'Identificador de correlación end-to-end; no contiene información sensible. Fuente: architecture.yml#CTRL-003']
  created_at timestamptz [not null, note: 'Instante de persistencia; permite aplicar retención cuando corresponde. Assumption: A-002. Fuente: SRC_ADR_013, DD-015']
  indexes {
    (diagnosis_id, evidence_id) [unique, name: 'diagnosis_evidence_links_diagnosis_id_evidence_id_uq']
  }
  Note: 'Traza qué evidencia operacional sustenta una versión diagnóstica. Owner: recommendation_service. approved_domain / confirmed.'
}

Table diagnosis.diagnosis_source_links {
  id uuid [pk, not null, note: 'Identificador estable asignado por el servicio propietario. Assumption: A-001. Fuente: architecture.yml#diagnostic_output_component, architecture.yml#rag_retrieval, SRC_ADR_013, DD-007']
  diagnosis_id uuid [not null, note: 'Versión diagnóstica que consultó RAG. Fuente: architecture.yml#diagnostic_output_component, architecture.yml#rag_retrieval, SRC_ADR_013, DD-007']
  knowledge_chunk_id uuid [not null, note: 'Chunk consultado; documento reconstruible mediante FK de knowledge_chunks. Referencia lógica a knowledge.knowledge_chunks.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#diagnostic_output_component, architecture.yml#rag_retrieval, SRC_ADR_013, DD-007']
  correlation_id text [not null, note: 'Identificador de correlación end-to-end; no contiene información sensible. Fuente: architecture.yml#CTRL-003']
  created_at timestamptz [not null, note: 'Instante de persistencia; permite aplicar retención cuando corresponde. Assumption: A-002. Fuente: SRC_ADR_013, DD-015']
  indexes {
    (diagnosis_id, knowledge_chunk_id) [unique, name: 'diagnosis_source_links_diagnosis_id_knowledge_chunk_id_uq']
  }
  Note: 'Traza consulted_sources: Diagnosis → KnowledgeChunk → KnowledgeDocument. Owner: recommendation_service. approved_domain / confirmed.'
}

Table diagnosis.human_reviews {
  id uuid [pk, not null, note: 'Identificador estable asignado por el servicio propietario. Assumption: A-001. Fuente: SRC_ADR_011, SRC_ADR_016, architecture.yml#INV-006, SRC_ADR_013, DD-005']
  diagnostic_id uuid [not null, note: 'Versión revisada; conserva el nombre contractual diagnostic_id de ADR-011. Fuente: SRC_ADR_011, SRC_ADR_016, architecture.yml#INV-006, SRC_ADR_013, DD-005']
  reviewer_ref text [not null, note: 'Identidad externa del revisor corporativo; mapea reviewer del contrato. Fuente: SRC_ADR_011, SRC_ADR_016, architecture.yml#INV-006, SRC_ADR_013, DD-005']
  decision diagnosis.HumanReviewDecision [not null, note: 'CONFIRMED acepta; CORRECTED aporta causa corregida; REJECTED rechaza sin alternativa validada. Fuente: SRC_ADR_011, SRC_ADR_016, architecture.yml#INV-006, SRC_ADR_013, DD-005']
  timestamp timestamptz [not null, note: 'Instante de revisión del contrato. Assumption: A-002. Fuente: SRC_ADR_011, SRC_ADR_016, architecture.yml#INV-006, SRC_ADR_013, DD-005']
  correlation_id text [not null, note: 'Identificador de correlación end-to-end; no contiene información sensible. Fuente: architecture.yml#CTRL-003']
  actual_cause text [null, note: 'Causa corregida suministrada por el revisor; requerida semánticamente en CORRECTED. Fuente: SRC_ADR_011, SRC_ADR_016, architecture.yml#INV-006, SRC_ADR_013, DD-005']
  comment text [null, note: 'Comentario saneado del revisor. Fuente: SRC_ADR_011, SRC_ADR_016, architecture.yml#INV-006, SRC_ADR_013, DD-005']
  created_at timestamptz [not null, note: 'Instante de persistencia; permite aplicar retención cuando corresponde. Assumption: A-002. Fuente: SRC_ADR_013, DD-015']
  checks {
    `decision <> 'CORRECTED' OR (actual_cause IS NOT NULL AND btrim(actual_cause) <> '')` [name: 'human_reviews_check_1']
  }
  Note: 'Revisión humana: ausencia = PENDING derivado; decision solo CONFIRMED, CORRECTED o REJECTED. Owner: recommendation_service. approved_domain / confirmed.'
}

Table knowledge.knowledge_documents {
  id uuid [pk, not null, note: 'Identificador estable asignado por el servicio propietario. Assumption: A-001. Fuente: architecture.yml#rag_retrieval, architecture.yml#INV-010, SRC_ADR_007, DD-007']
  corpus_kind knowledge.KnowledgeCorpusKind [not null, note: 'Clase de corpus autorizado. Fuente: architecture.yml#rag_retrieval, architecture.yml#INV-010, SRC_ADR_007, DD-007']
  title text [not null, note: 'Título de la fuente autorizada. Fuente: architecture.yml#rag_retrieval, architecture.yml#INV-010, SRC_ADR_007, DD-007']
  provenance text [not null, note: 'Referencia obligatoria de origen autorizado; nunca URL con tokens o secretos. Fuente: architecture.yml#rag_retrieval, architecture.yml#INV-010, SRC_ADR_007, DD-007']
  reviewed_incident_id uuid [null, note: 'Incidente revisado cuando el corpus es reviewed_incidents; elegibilidad RAG requiere separación evaluación. Referencia lógica a ops.incidents.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#rag_retrieval, architecture.yml#INV-010, SRC_ADR_007, DD-007']
  correlation_id text [not null, note: 'Identificador de correlación end-to-end; no contiene información sensible. Fuente: architecture.yml#CTRL-003']
  created_at timestamptz [not null, note: 'Instante de persistencia; permite aplicar retención cuando corresponde. Assumption: A-002. Fuente: SRC_ADR_013, DD-015']
  checks {
    `btrim(provenance) <> ''` [name: 'knowledge_documents_check_1']
    `corpus_kind <> 'reviewed_incidents' OR reviewed_incident_id IS NOT NULL` [name: 'knowledge_documents_check_2']
  }
  Note: 'Corpus autorizado; prohíbe casos de evaluación y soluciones de referencia conforme a INV-010. Owner: rag_retrieval. approved_domain / confirmed.'
}

Table knowledge.knowledge_chunks {
  id uuid [pk, not null, note: 'Identificador estable asignado por el servicio propietario. Assumption: A-001. Fuente: SRC_ADR_007, architecture.yml#INV-010, DD-009']
  document_id uuid [not null, note: 'Documento de procedencia; permite reconstruir fuentes. Fuente: SRC_ADR_007, architecture.yml#INV-010, DD-009']
  chunk_index integer [not null, note: 'Posición del chunk dentro del documento. Assumption: A-009. Fuente: SRC_ADR_007, architecture.yml#INV-010, DD-009']
  content text [not null, note: 'Fragmento autorizado y saneado; nunca casos/soluciones de evaluación. Fuente: SRC_ADR_007, architecture.yml#INV-010, DD-009']
  provenance text [not null, note: 'Procedencia obligatoria del fragmento dentro de su documento. Fuente: SRC_ADR_007, architecture.yml#INV-010, DD-009']
  embedding vector [null, note: 'Embedding pgvector; dimensión abierta, sin vector(n). Fuente: SRC_ADR_007, architecture.yml#INV-010, DD-009']
  correlation_id text [not null, note: 'Identificador de correlación end-to-end; no contiene información sensible. Fuente: architecture.yml#CTRL-003']
  created_at timestamptz [not null, note: 'Instante de persistencia; permite aplicar retención cuando corresponde. Assumption: A-002. Fuente: SRC_ADR_013, DD-015']
  indexes {
    (document_id, chunk_index) [unique, name: 'knowledge_chunks_document_id_chunk_index_uq']
  }
  checks {
    `chunk_index >= 0` [name: 'knowledge_chunks_check_1']
    `btrim(provenance) <> ''` [name: 'knowledge_chunks_check_2']
  }
  Note: 'Chunks recuperables de documentos autorizados; conserva provenance y pgvector sin dimensión fija. Owner: rag_retrieval. approved_domain / confirmed.'
}

Table audit.audit_events {
  id uuid [pk, not null, note: 'Identificador estable asignado por el servicio propietario. Assumption: A-001. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  category audit.AuditCategory [not null, note: 'Categoría funcional declarada en architecture.yml. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  correlation_id text [not null, note: 'Identificador de correlación end-to-end; no contiene información sensible. Fuente: architecture.yml#CTRL-003']
  actor_ref text [null, note: 'Identidad externa del actor cuando está disponible. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  entity_type text [not null, note: 'Tipo de objeto auditado; referencia polimórfica lógica. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  entity_id text [not null, note: 'ID lógico del objeto auditado; sin FK polimórfica. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  action text [not null, note: 'Acción funcional observada. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  before_state jsonb [null, note: 'Solo metadata sanitizada previa; prohíbe raw logs/payload sensible no enmascarado. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  after_state jsonb [null, note: 'Solo metadata sanitizada posterior; prohíbe secrets, tokens y credentials. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  occurred_at timestamptz [not null, note: 'Instante de ocurrencia del evento funcional. Assumption: A-002. Fuente: SRC_ADR_011, architecture.yml#audit_trail, architecture.yml#CTRL-002, DD-016']
  created_at timestamptz [not null, note: 'Instante de persistencia; permite aplicar retención cuando corresponde. Assumption: A-002. Fuente: SRC_ADR_013, DD-015']
  Note: 'Auditoría funcional transversal; before/after contienen solo metadata sanitizada, jamás logs crudos, secretos, tokens o credenciales. Owner: shared. approved_domain / confirmed.'
}

Ref pipelines_repository_id: ops.pipelines.repository_id > ops.repositories.id
Ref pipeline_executions_pipeline_id: ops.pipeline_executions.pipeline_id > ops.pipelines.id
Ref execution_stages_execution_id: ops.execution_stages.execution_id > ops.pipeline_executions.id
Ref incidents_pipeline_id: ops.incidents.pipeline_id > ops.pipelines.id
Ref incident_runs_incident_id: ops.incident_runs.incident_id > ops.incidents.id
Ref incident_runs_execution_id: ops.incident_runs.execution_id > ops.pipeline_executions.id
Ref pipeline_access_grants_pipeline_id: ops.pipeline_access_grants.pipeline_id > ops.pipelines.id
Ref recommendations_diagnosis_id: diagnosis.recommendations.diagnosis_id > diagnosis.diagnoses.id
Ref diagnosis_evidence_links_diagnosis_id: diagnosis.diagnosis_evidence_links.diagnosis_id > diagnosis.diagnoses.id
Ref diagnosis_source_links_diagnosis_id: diagnosis.diagnosis_source_links.diagnosis_id > diagnosis.diagnoses.id
Ref human_reviews_diagnostic_id: diagnosis.human_reviews.diagnostic_id > diagnosis.diagnoses.id
Ref knowledge_chunks_document_id: knowledge.knowledge_chunks.document_id > knowledge.knowledge_documents.id

TableGroup ops {
  ops.repositories
  ops.pipelines
  ops.pipeline_executions
  ops.execution_stages
  ops.incidents
  ops.incident_runs
  ops.pipeline_access_grants
}

TableGroup evidence {
  evidence.evidence_items
  evidence.correlated_contexts
}

TableGroup diagnosis {
  diagnosis.diagnoses
  diagnosis.recommendations
  diagnosis.diagnosis_evidence_links
  diagnosis.diagnosis_source_links
  diagnosis.human_reviews
}

TableGroup knowledge {
  knowledge.knowledge_documents
  knowledge.knowledge_chunks
}

TableGroup audit {
  audit.audit_events
}
